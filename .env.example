# --- Base de datos ---
# Base propia de esta vertical (NO compartir con KnowFlow operaciones).
# Local: postgres://knowflow:knowflow@localhost:5432/knowflow_ventas
# Neon:  postgresql://<user>:<pass>@<host>.neon.tech/knowflow_ventas?sslmode=require
DATABASE_URL=postgres://knowflow:knowflow@localhost:5432/knowflow_ventas
# Servidor persistente (Render): pool real. En serverless, déjalo sin definir.
DB_POOL_MAX=10

# --- NextAuth ---
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- Modo de aplicación ---
APP_MODE=investor_demo
# Solo en true cuando quieras re-sembrar la demo (npm run db:seed).
ALLOW_DESTRUCTIVE_SEED=false

# --- Embeddings (Google Gemini) — OBLIGATORIO ---
# Key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDINGS_PROVIDER=gemini

# --- Anthropic (OPCIONAL) ---
# Sin ella, el chat funciona en modo demo (la búsqueda semántica es real igual).
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Modelo rápido para el bucle de búsqueda del agente
ANTHROPIC_MODEL_AGENTE=claude-haiku-4-5

# --- RAG (calibrado para este rubro) ---
RAG_SIMILARITY_THRESHOLD=0.68
RAG_TOP_K=4
BRECHA_SIMILARITY_THRESHOLD=0.7

# --- URL base pública (para los QR) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
DEMO_BASE_URL=http://localhost:3000
